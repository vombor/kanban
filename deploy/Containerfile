# Dev container with the vombor/kanban fork (ghcr.io/vombor/kanban). Built by .github/workflows/image.yml and published
# to GHCR.
# Same toolset as the hand-built image, plus the standalone cline CLI (the fork's cline-cli agent, #643), Factory's droid
# CLI (npm @factory/cli, the droid agent) and gh.
# Kanban is installed from the fork's npm pack tarball (deploy/kanban.tgz, made in CI) instead of
# `npx kanban`, which fetched upstream at every start.
# AGENT_CLIS is resolved in CI to exact versions (pkg@x.y.z ...), so a new npm release of any of them
# changes the build arg, busts this layer and the next scheduled build picks it up.
FROM node:26-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    curl \
    nano \
    ca-certificates \
    unzip \
    bubblewrap \
    openssh-client && \
    rm -rf /var/lib/apt/lists/*

# GitHub CLI from GitHub's apt repository (https://cli.github.com/packages). No token or gh config in the image.
# Either pass the user's classic PAT as GH_TOKEN (a podman secret, docs/fork/github-auth.md: gh reads it natively, and
# explicit `kanban setup` adds the npm token reference and gh's git credential helper), or run `gh auth login` once.
# Authentication, agent config, projects and Kanban state are per-instance mounts, never image contents.
RUN mkdir -p -m 755 /etc/apt/keyrings && \
    curl -fsSL -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
      https://cli.github.com/packages/githubcli-archive-keyring.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*

ARG AGENT_CLIS="npm @anthropic-ai/claude-code @github/copilot @openai/codex cline @factory/cli"
RUN npm install -g --prefix=/usr/local --no-fund $AGENT_CLIS && npm cache clean --force

# cline 3.x (verified on 3.0.68) puts its Bedrock prompt-cache checkpoint on the last *user* message; in agent
# loops tool results are role "tool", so only the first prompt got cached (opus 10/06: 13K of 275K per turn,
# ~5x the cost). Same-length patch to the compiled binary + JS: checkpoint on the last non-assistant message.
# It also routes Amazon Nova 2 Lite (family "nova") to the cache point, on the last user message (Nova rejects one
# after a tool result; verified 3.0.69, 10/07). Warns instead of failing when a new cline no longer has the pattern.
COPY patch-cline-bedrock-cache.mjs /tmp/patch-cline-bedrock-cache.mjs
RUN node /tmp/patch-cline-bedrock-cache.mjs /usr/local/lib/node_modules/cline/bin/.cline \
      /usr/local/lib/node_modules/cline/node_modules/@cline/llms/dist/providers.js \
      || echo "WARNING: cline Bedrock cache patch did not apply (check upstream)"; \
    rm /tmp/patch-cline-bedrock-cache.mjs

COPY kanban.tgz /tmp/kanban.tgz
RUN npm install -g --prefix=/usr/local --no-fund /tmp/kanban.tgz && rm /tmp/kanban.tgz && npm cache clean --force

# No self-updates inside the container: the image build is the only update path (daily scheduled build).
#  KANBAN_NO_AUTO_UPDATE: Kanban would npm-install a newer @vombor/kanban from GitHub Packages over the image's build
#   (with GH_TOKEN set it can read the registry).
#  CLINE_NO_AUTO_UPDATE: cline 3.x background updates restart its hub daemon under live sessions.
#  DISABLE_AUTOUPDATER: Claude Code.
# Copilot's documented switch and Droid's CLI switch also keep the image's installed versions.
ENV KANBAN_NO_AUTO_UPDATE=1 \
    KANBAN_UPDATE_MODE=image \
    CLINE_NO_AUTO_UPDATE=1 \
    DISABLE_AUTOUPDATER=1 \
    COPILOT_AUTO_UPDATE=false \
    FACTORY_DROID_AUTO_UPDATE_ENABLED=false

# Build packages as root, execute them as node. Fresh instances have an empty projects directory and no registered
# projects. Bind mount permissions remain the deployment's responsibility. Agent/user files use HOME; Kanban-owned
# state uses KANBAN_HOME/--home, defaulting to $HOME/.kanban in the entrypoint and canonical runtime resolver.
RUN mkdir -p /projects && chown node:node /projects
ENV HOME=/home/node
USER node

WORKDIR /projects

EXPOSE 3484
EXPOSE 3600

# Container lifecycle (docs/fork/container-lifecycle.md): kanban-entrypoint runs the CMD (or a quadlet Exec=
# override) as its child. Start/pre-stop hooks are explicit per-instance configuration;
# every stop (podman stop, systemctl stop/restart, podman auto-update, host shutdown) first runs
# the pre-stop hook (at most KANBAN_PRESTOP_TIMEOUT s, default 45) and `kanban restart prepare` (at most
# KANBAN_RESTART_PREPARE_TIMEOUT s, default 20), then passes the signal on to Kanban
# (which gives itself up to 10 s more). It replaces node's docker-entrypoint.sh, which only prefixes `node` when the
# command is a flag or not on PATH.
# An image cannot set a stop timeout, and podman stop's default of 10 s would SIGKILL mid-hook: run the container
# with StopTimeout=90 in the quadlet (`podman run --stop-timeout 90`), and give the systemd unit more than that
# (TimeoutStopSec=120; its default is 90 s).
COPY --chmod=755 kanban-entrypoint.sh /usr/local/bin/kanban-entrypoint
STOPSIGNAL SIGTERM
# podman auto-update picks up containers with this label; podman copies image labels into the container's.
# It still needs the container to run under a systemd unit (quadlet), and a fully qualified image name.
LABEL io.containers.autoupdate=registry
# GHCR links the ghcr.io/vombor/kanban package to the repository through this label, so the repo's PAT can push it and
# the package shows on the repo. CI's docker/metadata-action sets the same label from the repo it runs in.
LABEL org.opencontainers.image.source=https://github.com/vombor/kanban
# The image's own build, for `kanban restart update` (src/update/container-image.ts): CI passes the commit and
# docker/metadata-action's created time, the same values as the org.opencontainers.image.revision/.created labels, so
# Kanban compares its env with the labels of the registry's tag it follows (update.imageChannel: :latest or :stable).
# KANBAN_IMAGE_VERSION is the release version (package.json's, e.g. 0.1.70-fork.8) on a release build only, the same
# value as CI's dev.vombor.kanban.release label; empty in every other build. Last, so a new build only changes this
# layer's metadata. Unset in a local build: `restart update` then needs --force.
ARG KANBAN_IMAGE_REVISION=""
ARG KANBAN_IMAGE_CREATED=""
ARG KANBAN_IMAGE_VERSION=""
ENV KANBAN_IMAGE_REVISION=$KANBAN_IMAGE_REVISION \
    KANBAN_IMAGE_CREATED=$KANBAN_IMAGE_CREATED \
    KANBAN_IMAGE_VERSION=$KANBAN_IMAGE_VERSION
ENTRYPOINT ["/usr/local/bin/kanban-entrypoint"]

# The CLI defaults to 3484; the installation can set KANBAN_RUNTIME_PORT without replacing CMD.
# :: is dual-stack on Linux: both IPv4 and IPv6 localhost must reach a rootless pod's published port.
CMD ["kanban", "--host", "::", "--no-open", "--no-passcode", "--skip-shutdown-cleanup"]
